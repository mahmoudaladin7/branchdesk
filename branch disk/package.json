{
  "name": "branchdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node bin/branchdesk.mjs",
    "demo": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write app lib server bin tests components vite.config.ts"
  },
  "devDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "radix-ui": "^1.6.7",
    "lucide-react": "^1.31.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "prettier": "^3.6.2"
  },
  "type": "module",
  "description": "Your local repositories, back in focus. An open-source, read-only Git dashboard.",
  "bin": {
    "branchdesk": "bin/branchdesk.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mahmoudaladin7/branchdesk.git"
  },
  "license": "MIT",
  "keywords": [
    "git",
    "dashboard",
    "developer-tools",
    "local-first",
    "repositories"
  ],
  "homepage": "https://github.com/mahmoudaladin7/branchdesk"
}
